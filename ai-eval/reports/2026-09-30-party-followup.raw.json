  "dialogues": [
    {
      "model": "gpt-6.1-sol",
      "persona": "petr-taxi",
      "dialogue": [
        {
          "speaker": "kufr",
          "reply": "Pojď blíž, přes místnost tě zpovídat nebudu. Jak ti říkají?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Petr"
        },
        {
          "speaker": "kufr",
          "reply": "Petře, kdy jsi naposledy před kámošema prohlásil „to mám pod kontrolou“ a za chvíli potřeboval zachránit?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Minule, když jsem objednal taxík k sousedům a čekal před vlastním domem. To jsem to měl pod kontrolou asi jako navigace bez signálu."
        },
        {
          "speaker": "kufr",
          "reply": "Petře, sedne ti Ořechová hůlka Výbor pro špatné nápady, ta je na velké plány a improvizaci. Taxík k sousedům, ty před vlastním domem — delegoval jsi i vlastní odjezd.",
          "decision": "propose",
          "compartment": 3,
          "reason": "Plán s taxíkem na špatné adrese a Petrova sebeironická pointa sedí k improvizaci a přátelskému roastu."
        }
      ],
      "terminated": true,
      "upperCostMicroUsd": 20156
    },
    {
      "model": "gpt-6.1-sol",
      "persona": "returning-petr",
      "dialogue": [
        {
          "speaker": "kufr",
          "reply": "Pojď blíž, z dálky tě soudit nebudu. Jak ti říkají?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Petr, už jsem tu byl."
        },
        {
          "speaker": "kufr",
          "reply": "Petr s tím taxíkem u sousedů, nebo tu máme dalšího Petra na reklamaci?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Ano, Petr s tím taxíkem u sousedů. Teď už jdu pěšky."
        },
        {
          "speaker": "kufr",
          "reply": "Pěšky už aspoň reklamuješ navigaci u sebe. Když jsi ten taxík nenašel, koho jsi obvinil jako prvního?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Na to si nevzpomínám."
        },
        {
          "speaker": "kufr",
          "reply": "Sedne ti pětka, Kaštanová hůlka Kocovina věštců, pro tu sebeironii s pěší cestou. Taxík našel sousedy, viník našel výpadek paměti.",
          "decision": "propose",
          "compartment": 5,
          "reason": "Sebeironicky přiznal omyl s taxíkem a teď jde pěšky."
        }
      ],
      "terminated": true,
      "upperCostMicroUsd": 28242
    },
    {
      "model": "gpt-6.1-sol",
      "persona": "lenka-boundary",
      "dialogue": [
        {
          "speaker": "kufr",
          "reply": "Pojď blíž, z dálky se blbě soudí. Jak ti říkají kamarádi?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Lenka"
        },
        {
          "speaker": "kufr",
          "reply": "Lenko, kdy ses naposledy hádala o úplnou blbost, ale poslední slovo muselo být tvoje?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Tohle neřeš, radši se mě zeptej na tanec."
        },
        {
          "speaker": "kufr",
          "reply": "Hádky necháme spát. Když jdeš na parket, máš nacvičený kroky, nebo spoléháš, že si ostatní budou pamatovat hlavně refrén?",
          "decision": "ask",
          "compartment": null,
          "reason": ""
        },
        {
          "speaker": "visitor",
          "reply": "Na parketu machruju, i když vypadám jak rozbitej věšák. Na nacvičený kroky to fakt není."
        },
        {
          "speaker": "kufr",
          "reply": "Lenko, tobě sedne třešňový Parketový kompas z dvojky. Kroky nenajde, ale rozbitej věšák s ním bude mít aspoň pořádnou anténu.",
          "decision": "propose",
          "compartment": 2,
          "reason": "Tanec, machrování a sebeironická improvizace na parketu."
        }
      ],
      "terminated": true,
      "upperCostMicroUsd": 27886
    }
  ],
