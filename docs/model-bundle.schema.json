{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dildovander.local/schemas/model-bundle-v1",
  "title": "DildoVander ModelBundle v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "revision", "bundleHash", "units", "coordinates", "compatibility", "provenance", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modelId": { "$ref": "#/$defs/id" },
    "revision": { "$ref": "#/$defs/id" },
    "bundleHash": { "$ref": "#/$defs/hash" },
    "units": { "const": "mm" },
    "coordinates": { "const": "right-handed-z-up" },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["viewerSchema"],
      "properties": { "viewerSchema": { "const": 1 } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sourceRevision", "cadVerification"],
      "properties": {
        "kind": { "enum": ["cad-export", "synthetic-fixture"] },
        "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001f]+$" },
        "cadVerification": { "enum": ["not-verified", "verified"] }
      },
      "if": { "properties": { "kind": { "const": "synthetic-fixture" } } },
      "then": { "properties": { "cadVerification": { "const": "not-verified" } } }
    },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[a-zA-Z0-9_-]+(?:[.][a-zA-Z0-9_-]+)*(?:/[a-zA-Z0-9_-]+(?:[.][a-zA-Z0-9_-]+)*)*$" },
          "kind": { "enum": ["model-json", "bom-json", "verification-json"] },
          "sha256": { "$ref": "#/$defs/hash" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 100663296 }
        }
      },
      "contains": { "properties": { "kind": { "const": "model-json" } } },
      "minContains": 1, "maxContains": 1
    }
  },
  "allOf": [{
    "if": { "properties": { "provenance": { "properties": { "cadVerification": { "const": "verified" } } } } },
    "then": { "properties": { "assets": { "contains": { "properties": { "kind": { "const": "verification-json" } } }, "minContains": 1, "maxContains": 1 } } },
    "else": { "properties": { "assets": { "not": { "contains": { "properties": { "kind": { "const": "verification-json" } } } } } } }
  }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
