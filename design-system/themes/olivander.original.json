{
  "$schemaVersion": 1,
  "name": "Vapour Chrome",
  "primitives": {
    "mist": "#EEF1F5",
    "midnight": "#1B2430",
    "steel": "#8A94A6",
    "periwinkle": "#B8C0FF"
  },
  "themes": {
    "dark": {
      "void": "var(--aw-midnight)",
      "surface": "#222D3B",
      "elevated": "#2D394A",
      "ivory": "var(--aw-mist)",
      "muted": "#B4BECE",
      "accent": "var(--aw-periwinkle)",
      "on-accent": "var(--aw-midnight)",
      "accent-soft": "#303C58",
      "success": "#91D7B6",
      "danger": "#FFADA8",
      "warning": "#EDCC92",
      "info": "#B8C0FF",
      "border": "#7B899E",
      "border-subtle": "#3B485B",
      "shadow": "0 8px 24px #0C121C24",
      "brass": "var(--aw-accent)",
      "disabled-foreground": "var(--aw-muted)",
      "disabled-background": "var(--aw-elevated)",
      "viewer-background": "var(--aw-void)",
      "viewer-grid": "var(--aw-border-subtle)",
      "viewer-selection": "var(--aw-accent)",
      "overlay": "#0C121C99"
    },
    "light": {
      "void": "var(--aw-mist)",
      "surface": "#FFFFFF",
      "elevated": "#E2E7EF",
      "ivory": "var(--aw-midnight)",
      "muted": "#586579",
      "accent": "#4E5594",
      "on-accent": "#FFFFFF",
      "accent-soft": "#E7E9FC",
      "success": "#256447",
      "danger": "#AD3939",
      "warning": "#805B19",
      "info": "#4E5594",
      "border": "#758295",
      "border-subtle": "#CDD4DF",
      "shadow": "0 8px 24px #1B24300A",
      "brass": "var(--aw-accent)",
      "disabled-foreground": "var(--aw-muted)",
      "disabled-background": "var(--aw-elevated)",
      "viewer-background": "var(--aw-void)",
      "viewer-grid": "var(--aw-border-subtle)",
      "viewer-selection": "var(--aw-accent)",
      "overlay": "#1B243066"
    }
  },
  "fonts": [
    {
      "family": "Inter",
      "file": "inter.ttf",
      "weight": "100 900"
    },
    {
      "family": "IBM Plex Mono",
      "file": "ibmplexmono.ttf",
      "weight": "400"
    }
  ],
  "typography": {
    "font-display": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "font-ui": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "font-mono": "'IBM Plex Mono', 'Cascadia Mono', Consolas, monospace",
    "text-small": ".8125rem",
    "text-body": ".9375rem",
    "text-caption": ".75rem",
    "text-label": ".8125rem",
    "text-heading": "1.125rem",
    "text-subheading": "1rem",
    "text-button": ".875rem",
    "text-technical": ".8125rem",
    "text-display": "clamp(2.5rem, 5.5vw, 4.25rem)",
    "text-title": "clamp(1.875rem, 3.5vw, 3rem)",
    "line-body": "1.55",
    "line-heading": "1.2",
    "weight-heading": "600",
    "weight-label": "600",
    "tracking-heading": "-.035em"
  },
  "layout": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "radius-card": "10px",
    "radius-control": "6px",
    "touch": "44px",
    "control-height-small": "44px",
    "content-max": "1440px",
    "dialog-max": "36rem",
    "layer-sticky": "10",
    "layer-overlay": "20",
    "layer-dialog": "30",
    "disabled-opacity": ".6",
    "breakpoint-compact": "640px",
    "breakpoint-medium": "960px",
    "breakpoint-wide": "1280px",
    "safe-top": "env(safe-area-inset-top, 0px)",
    "safe-right": "env(safe-area-inset-right, 0px)",
    "safe-bottom": "env(safe-area-inset-bottom, 0px)",
    "safe-left": "env(safe-area-inset-left, 0px)"
  },
  "motion": {
    "motion-fast": "150ms",
    "motion-normal": "200ms",
    "motion-slow": "250ms",
    "ease-out": "cubic-bezier(.16, 1, .3, 1)"
  },
  "reducedMotion": {
    "motion-fast": "0ms",
    "motion-normal": "0ms",
    "motion-slow": "0ms"
  }
}
