{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "GptLive": {
      "ActorMode": "AutonomousActor",
      "DecisionModel": "gpt-6.1-sol",
      "AdultLanguage": true,
      "TranscriptCharacterLimit": 128000,
      "DecisionContextBytes": 8000,
      "DelegationContextWaitMs": 350,
      "InputQuietMs": 1200,
      "DelegationTimeoutMs": 8000,
      "OutputPauseMs": 900,
      "TerminalQuietMs": 4000,
      "TerminalTimeoutSeconds": 35,
      "SpeechAmplitudeThreshold": 256
    },
    "Memory": {
      "Enabled": true,
      "CloudIndexingEnabled": false,
      "LongTermPersonalEnabled": true,
      "AppNamespace": "kufr",
      "PersonalStoreId": "",
      "MotifStoreId": "",
      "ContextTokens": 500,
      "SearchResults": 5,
      "TimeoutSeconds": 15,
      "Concurrency": 2,
      "MaxAttempts": 6,
      "RetryBaseSeconds": 2,
      "IndexPollSeconds": 2,
      "IndexTimeoutSeconds": 120,
      "MaxWritesPerDay": 2000,
      "MaxSearchesPerDay": 100,
      "MaxUploadsPerDay": 500,
      "MaxStoredBytes": 2000000,
      "MaxRecordBytes": 2000,
      "MaxPendingJobs": 4000
    },
    "Conversation": {
      "ContractVersion": 2,
      "DefaultEngine": "gpt-live",
      "LiveModel": "gpt-live-1",
      "RealtimeModel": "gpt-realtime-2.1"
    },
    "Vision": {
      "Model": "gpt-6.1-sol"
    }
  }
}
