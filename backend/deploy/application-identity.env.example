# Explicitly disabled preparation only. Copy into the private backend environment
# after provisioning durable paths, accepted DNS origin and bootstrap procedure.
ApplicationIdentity__Enabled=false
ApplicationIdentity__DataRoot=/var/lib/kufr-backend/application-identity
ApplicationIdentity__DataProtectionRoot=/var/lib/kufr-backend/keepsakes.keys
ApplicationIdentity__RelyingPartyId=application.example.invalid
ApplicationIdentity__AllowedOrigins__0=https://application.example.invalid
# AASA authorizes these explicit signed-app identities for passkeys.
# The legacy AppleAppId scalar remains additive for existing installations.
# ApplicationIdentity__AppleAppIds__0=TEAM000001.com.example.companion
# ApplicationIdentity__AppleAppIds__1=TEAM000002.com.example.store
# The root must equal the established DV10 key root when both features are enabled.
# Keep the existing Data Protection application name/purposes and all previous keys.
# Bootstrap provisioning is separate, expiring, hashed and never a public artifact:
# ApplicationIdentity__Bootstrap__TokenSha256=<provision privately>
# ApplicationIdentity__Bootstrap__ExpiresAt=<UTC ISO timestamp>
