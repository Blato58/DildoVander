# Separate root-owned 0640 file; no credentials in a release or browser bundle.
# Install only during authorized delivery. Keepsake stays off until all gates pass.
Keepsake__Enabled=false
Keepsake__PublicDeviceId=
Keepsake__ProviderMode=fake
Keepsake__GenerationEnabled=false
Keepsake__PortraitEnabled=false
Keepsake__Origin=https://keepsake.example.invalid
Keepsake__DataRoot=/var/lib/kufr-backend/keepsakes
Keepsake__DataProtectionRoot=/var/lib/kufr-backend/keepsakes.keys
# Effective code retention is manual_only; this comment does not create a setting.
# Backend__DatabasePath remains /var/lib/kufr-backend/journal.sqlite.
