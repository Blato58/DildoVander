location ^~ /third-party-notices/ {
    root /var/www/dildovander/current;
    try_files $uri =404;
    autoindex off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
# Hashed Vite assets are retained across app activation for open tabs.
location ^~ /assets/ {
    root /var/www/dildovander;
    try_files $uri =404;
    autoindex off;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
}
location = /models/active.json {
    root /var/lib/dildovander;
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
location ^~ /models/bundles/ {
    root /var/lib/dildovander;
    try_files $uri =404;
    autoindex off;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    add_header X-Content-Type-Options "nosniff" always;
}
# Distribution data is durable and independent of application/model activation.
location = /downloads/index.json {
    root /var/lib/dildovander;
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
location ~ "^/downloads/releases/[a-f0-9]{64}/[A-Za-z0-9][A-Za-z0-9_.-]{0,159}[.](?:zip|pdf|step|stp|stl|3mf|dxf|txt)$" {
    if ($request_uri !~ "^/downloads/releases/[a-f0-9]{64}/[A-Za-z0-9_.-]+[.](?:zip|pdf|step|stp|stl|3mf|dxf|txt)(?:[?]|$)") { return 404; }
    if ($request_method !~ "^(GET|HEAD)$") { return 405; }
    root /var/lib/dildovander;
    try_files $uri =404;
    autoindex off;
    types { }
    default_type application/octet-stream;
    add_header Content-Disposition "attachment" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
location /downloads/ { return 404; }
# Original hosted builder linked /workshop/<revision>-kouzelny-kufr.zip.
location ~ "^/workshop/[A-Za-z0-9][A-Za-z0-9_.-]{0,159}-kouzelny-kufr[.]zip$" {
    if ($request_uri !~ "^/workshop/[A-Za-z0-9_.-]+-kouzelny-kufr[.]zip(?:[?]|$)") { return 404; }
    if ($request_method !~ "^(GET|HEAD)$") { return 405; }
    root /var/lib/dildovander/downloads/legacy;
    try_files $uri =404;
    types { }
    default_type application/octet-stream;
    add_header Content-Disposition "attachment" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

