# Plain prefix allows the anchored regex routes above; ^~ would disable them.
location /guest/ { access_log off; return 404; }
location = /guest { return 404; }
# Unknown API routes must not reach an SPA fallback.
location /api/ { return 404; }
location = /api { return 404; }

if ($host != keepsake.example.invalid) { return 421; }
# Arcane Workshop routes; leave API, iOS and CloudVPSBridge locations intact.
location = / {
    root /var/www/dildovander/current;
    try_files /index.html =404;
    add_header Cache-Control "no-store" always;
}
location = /site-manifest.json {
    root /var/www/dildovander/current;
    add_header Cache-Control "no-store" always;
}
location = /site.css {
    root /var/www/dildovander/current;
    add_header Cache-Control "no-store" always;
}
location = /workshop { return 308 /workshop/; }
location ^~ /workshop/ {
    alias /var/www/dildovander/current/workshop/;
    index index.html;
    autoindex off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
location = /companion { return 308 /companion/; }
location ^~ /companion/ {
    alias /var/www/dildovander/current/companion/;
    index index.html;
    autoindex off;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
}
location = /simulator { return 308 /simulator/; }
location ^~ /simulator/ {
