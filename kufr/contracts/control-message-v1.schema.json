{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kufr:control-message:v1",
  "title": "Kufr local control messages v1",
  "oneOf": [
    { "$ref": "#/$defs/danceStart" },
    { "$ref": "#/$defs/danceStop" },
    { "$ref": "#/$defs/danceAck" },
    { "$ref": "#/$defs/voiceConfigure" },
    { "$ref": "#/$defs/voiceStart" },
    { "$ref": "#/$defs/voiceStop" },
    { "$ref": "#/$defs/voiceAck" },
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/stateGet" },
    { "$ref": "#/$defs/controlAcquire" },
    { "$ref": "#/$defs/controlRelease" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/heartbeatAck" },
    { "$ref": "#/$defs/selectionStart" },
    { "$ref": "#/$defs/inventoryConfirmReload" },
    { "$ref": "#/$defs/conversationText" },
    { "$ref": "#/$defs/conversationCancel" },
    { "$ref": "#/$defs/conversationAck" },
    { "$ref": "#/$defs/conversationResult" },
    { "$ref": "#/$defs/mediaAuthorize" },
    { "$ref": "#/$defs/commandAck" },
    { "$ref": "#/$defs/selectionResult" },
    { "$ref": "#/$defs/stateSnapshot" },
    { "$ref": "#/$defs/safetyStop" },
    { "$ref": "#/$defs/safetyReset" }
  ],
  "$defs": {
    "danceStart": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId", "expectedRevision"],
      "properties": {
        "protocolVersion": { "const": 1 }, "type": { "const": "dance.start" },
        "messageId": { "$ref": "#/$defs/uuid" }, "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }, "expectedRevision": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "danceStop": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId"],
      "properties": {
        "protocolVersion": { "const": 1 }, "type": { "const": "dance.stop" },
        "messageId": { "$ref": "#/$defs/uuid" }, "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }
      }
    },
    "danceStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "phase", "track", "positionMs", "durationMs", "bpm", "error"],
      "properties": {
        "available": { "type": "boolean" },
        "phase": { "enum": ["unavailable", "idle", "starting", "playing", "stopping", "completed", "failed"] },
        "track": { "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,59}\\.wav$" }] },
        "positionMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "bpm": { "type": "integer", "minimum": 0, "maximum": 240 },
        "error": { "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 64, "pattern": "^dance_[a-z_]+$" }] }
      }
    },
    "danceAck": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "type", "bootId", "requestMessageId", "accepted", "dance"],
      "properties": {
        "protocolVersion": { "const": 1 }, "type": { "const": "dance.ack" },
        "bootId": { "$ref": "#/$defs/uuid" }, "requestMessageId": { "$ref": "#/$defs/uuid" },
        "accepted": { "type": "boolean" }, "dance": { "$ref": "#/$defs/danceStatus" }
      }
    },
    "voiceConfigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "deviceId",
        "bootId",
        "mode",
        "voice"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "voice.configure"
        },
        "messageId": {
          "$ref": "#/$defs/uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/deviceId"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "mode": {
          "enum": [
            "off",
            "realtime",
            "gpt-live"
          ]
        },
        "voice": {
          "enum": [
            "cedar",
            "marin",
            "coral"
          ]
        }
      }
    },
    "voiceStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "deviceId",
        "bootId",
        "expectedRevision"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "voice.start"
        },
        "messageId": {
          "$ref": "#/$defs/uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/deviceId"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "imageConsent": { "type": "boolean" },
        "expectedRevision": {
          "$ref": "#/$defs/safeInteger"
        }
      }
    },
    "voiceStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "deviceId",
        "bootId"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "voice.stop"
        },
        "messageId": {
          "$ref": "#/$defs/uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/deviceId"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "voiceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "mode",
        "voice",
        "phase",
        "error"
      ],
      "properties": {
        "cameraAvailable": { "type": "boolean" },
        "photoWarning": { "enum": [null, "photo_unavailable", "photo_failed"] },
        "available": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "off",
            "realtime",
            "gpt-live"
          ]
        },
        "voice": {
          "enum": [
            "cedar",
            "marin",
            "coral"
          ]
        },
        "phase": {
          "enum": [
            "unavailable",
            "idle",
            "starting",
            "photo_capture",
            "photo_upload",
            "photo_wait",
            "listening",
            "thinking",
            "speaking",
            "stopping",
            "completed",
            "failed"
          ]
        },
        "error": {
          "enum": [
            null,
            "ai_unavailable",
            "audio_failed",
            "cost_limit"
          ]
        }
      }
    },
    "voiceAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "bootId",
        "requestMessageId",
        "accepted",
        "voice"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "voice.ack"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "requestMessageId": {
          "$ref": "#/$defs/uuid"
        },
        "accepted": {
          "type": "boolean"
        },
        "voice": {
          "$ref": "#/$defs/voiceStatus"
        }
      }
    },
    "uuid": { "type": "string", "format": "uuid", "maxLength": 36 },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid_message",
        "unsupported_version",
        "unauthorized",
        "controller_busy",
        "wrong_boot",
        "wrong_session",
        "wrong_generation",
        "turn_limit_reached",
        "lease_expired",
        "expired",
        "stale_revision",
        "sequence_gap",
        "already_seen_result_unavailable",
        "id_conflict",
        "busy",
        "compartment_unavailable",
        "not_calibrated",
        "safety_latched",
        "i2c_timeout",
        "journal_failed",
        "outcome_unknown"
      ]
    },
    "faultCode": {
      "type": "string",
      "enum": [
        "i2c_timeout",
        "watchdog_timeout",
        "calibration_invalid",
        "journal_failed",
        "brownout"
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "hello" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestMessageId", "snapshot"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "welcome" },
        "requestMessageId": { "$ref": "#/$defs/uuid" },
        "snapshot": { "$ref": "#/$defs/stateSnapshot" }
      }
    },
    "stateGet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "state.get" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }
      }
    },
    "controlAcquire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "control.acquire" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }
      }
    },
    "controlRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId", "controlLeaseId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "control.release" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId", "controlLeaseId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "heartbeat" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" }
      }
    },
    "heartbeatAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "requestMessageId", "bootId", "deviceUptimeMs", "revision", "controlLeaseId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "heartbeat.ack" },
        "requestMessageId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "deviceUptimeMs": { "$ref": "#/$defs/safeInteger" },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" }
      }
    },
    "selectionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "deviceId",
        "bootId",
        "controlLeaseId",
        "sequence",
        "expectedRevision",
        "issuedAtDeviceMs",
        "maxAgeMs",
        "payload"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "selection.start" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/safeInteger" },
        "expectedRevision": { "$ref": "#/$defs/safeInteger" },
        "issuedAtDeviceMs": { "$ref": "#/$defs/safeInteger" },
        "maxAgeMs": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compartment", "selectionSource"],
          "properties": {
            "compartment": { "type": "integer", "minimum": 1, "maximum": 6 },
            "selectionSource": {
              "type": "string",
              "enum": [
                "manual",
                "operatorConfirmedAi",
                "operatorCorrectedAi",
                "buttonConfirmedAi"
              ]
            }
          }
        }
      }
    },
    "inventoryConfirmReload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "commandId", "deviceId", "bootId",
        "controlLeaseId", "sequence", "expectedRevision", "issuedAtDeviceMs",
        "maxAgeMs", "payload"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "inventory.confirmReload" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/safeInteger" },
        "expectedRevision": { "$ref": "#/$defs/safeInteger" },
        "issuedAtDeviceMs": { "$ref": "#/$defs/safeInteger" },
        "maxAgeMs": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compartment", "inspectionConfirmed"],
          "properties": {
            "compartment": { "type": "integer", "minimum": 1, "maximum": 6 },
            "inspectionConfirmed": { "const": true }
          }
        }
      }
    },
    "conversationText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "messageId", "deviceId", "bootId",
        "controlLeaseId", "conversationId", "clientTurnId", "generation",
        "expectedRevision", "text"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "conversation.text" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "conversationId": { "$ref": "#/$defs/uuid" },
        "clientTurnId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "expectedRevision": { "$ref": "#/$defs/safeInteger" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "conversationCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "messageId", "deviceId", "bootId",
        "controlLeaseId", "conversationId", "generation"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "conversation.cancel" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "conversationId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "conversationAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "requestMessageId", "bootId",
        "conversationId", "clientTurnId", "generation", "eventSequence",
        "status", "duplicate", "errorCode"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "conversation.ack" },
        "requestMessageId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "conversationId": { "$ref": "#/$defs/uuid" },
        "clientTurnId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "status": { "enum": ["accepted", "rejected"] },
        "duplicate": { "type": "boolean" },
        "errorCode": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/errorCode" }]
        }
      },
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": { "properties": { "errorCode": { "type": "null" } } },
      "else": { "properties": { "errorCode": { "$ref": "#/$defs/errorCode" } } }
    },
    "conversationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "bootId", "conversationId",
        "clientTurnId", "generation", "eventSequence", "reply", "simulated"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "conversation.result" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "conversationId": { "$ref": "#/$defs/uuid" },
        "clientTurnId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "reply": { "type": "string", "minLength": 1, "maxLength": 500 },
        "simulated": { "type": "boolean" }
      }
    },
    "mediaAuthorize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "type", "requestMessageId", "bootId",
        "controlLeaseId", "mediaTicket"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "media.authorize" },
        "requestMessageId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "mediaTicket": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "commandAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "bootId",
        "eventSequence",
        "status",
        "revision",
        "errorCode"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "command.ack" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "status": { "enum": ["accepted", "rejected"] },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "errorCode": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/errorCode" }
          ]
        }
      },
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": { "properties": { "errorCode": { "type": "null" } } },
      "else": { "properties": { "errorCode": { "$ref": "#/$defs/errorCode" } } }
    },
    "selectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "bootId",
        "eventSequence",
        "status",
        "revision",
        "compartment",
        "physicalVerification",
        "requiresReload"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "selection.result" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "status": { "enum": ["completed", "aborted", "outcome_unknown"] },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "compartment": { "type": "integer", "minimum": 1, "maximum": 6 },
        "physicalVerification": { "const": "unavailable" },
        "requiresReload": { "type": "boolean" }
      }
    },
    "stateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "deviceId",
        "bootId",
        "deviceUptimeMs",
        "eventSequence",
        "revision",
        "controlMode",
        "controlLeaseId",
        "phase",
        "activeCommandId",
        "readyMask",
        "calibrationRevision",
        "faults",
        "microphoneState",
        "capabilities",
        "lastResult",
        "conversation"
      ],
      "properties": {
        "voice": { "$ref": "#/$defs/voiceStatus" },
        "dance": { "$ref": "#/$defs/danceStatus" },
        "protocolVersion": { "const": 1 },
        "type": { "const": "state.snapshot" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "deviceUptimeMs": { "$ref": "#/$defs/safeInteger" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "controlMode": { "enum": ["standalone", "manual", "recovery"] },
        "controlLeaseId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "phase": {
          "enum": [
            "bootSafe",
            "recoveryRequired",
            "ready",
            "searching",
            "highlighting",
            "vibrating",
            "releasing",
            "presenting",
            "dancing",
            "stopped",
            "fault"
          ]
        },
        "activeCommandId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "readyMask": { "type": "integer", "minimum": 0, "maximum": 63 },
        "calibrationRevision": { "$ref": "#/$defs/safeInteger" },
        "faults": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/faultCode" }
        },
        "microphoneState": {
          "enum": ["unavailable", "idle", "recording", "playing"]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
        },
        "lastResult": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/selectionResult" }
          ]
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversationId", "generation", "activeTurnId"],
          "properties": {
            "conversationId": { "$ref": "#/$defs/uuid" },
            "generation": { "$ref": "#/$defs/safeInteger" },
            "activeTurnId": {
              "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
            }
          }
        }
      },
      "if": { "properties": { "controlMode": { "const": "manual" } } },
      "then": { "properties": { "controlLeaseId": { "$ref": "#/$defs/uuid" } } },
      "else": { "properties": { "controlLeaseId": { "type": "null" } } }
    },
    "safetyStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "safety.stop" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }
      }
    },
    "safetyReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "deviceId",
        "bootId",
        "controlLeaseId",
        "inspectionConfirmed"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "safety.reset" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "inspectionConfirmed": { "const": true }
      }
    }
  }
}
