{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kufr:control-message:v1",
  "title": "Kufr local control messages v1",
  "oneOf": [
    { "$ref": "#/$defs/selectionStart" },
    { "$ref": "#/$defs/commandAck" },
    { "$ref": "#/$defs/selectionResult" },
    { "$ref": "#/$defs/stateSnapshot" },
    { "$ref": "#/$defs/safetyStop" },
    { "$ref": "#/$defs/safetyReset" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "maxLength": 36 },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "invalid_message",
        "unsupported_version",
        "unauthorized",
        "controller_busy",
        "wrong_boot",
        "lease_expired",
        "expired",
        "stale_revision",
        "sequence_gap",
        "already_seen_result_unavailable",
        "id_conflict",
        "busy",
        "compartment_unavailable",
        "not_calibrated",
        "safety_latched",
        "i2c_timeout",
        "journal_failed",
        "outcome_unknown"
      ]
    },
    "faultCode": {
      "type": "string",
      "enum": [
        "i2c_timeout",
        "watchdog_timeout",
        "calibration_invalid",
        "journal_failed",
        "brownout"
      ]
    },
    "selectionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "deviceId",
        "bootId",
        "controlLeaseId",
        "sequence",
        "expectedRevision",
        "issuedAtDeviceMs",
        "maxAgeMs",
        "payload"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "selection.start" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "sequence": { "$ref": "#/$defs/safeInteger" },
        "expectedRevision": { "$ref": "#/$defs/safeInteger" },
        "issuedAtDeviceMs": { "$ref": "#/$defs/safeInteger" },
        "maxAgeMs": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compartment", "selectionSource"],
          "properties": {
            "compartment": { "type": "integer", "minimum": 1, "maximum": 6 },
            "selectionSource": {
              "type": "string",
              "enum": [
                "manual",
                "operatorConfirmedAi",
                "operatorCorrectedAi",
                "buttonConfirmedAi"
              ]
            }
          }
        }
      }
    },
    "commandAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "bootId",
        "eventSequence",
        "status",
        "revision",
        "errorCode"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "command.ack" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "status": { "enum": ["accepted", "rejected"] },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "errorCode": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/errorCode" }
          ]
        }
      },
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": { "properties": { "errorCode": { "type": "null" } } },
      "else": { "properties": { "errorCode": { "$ref": "#/$defs/errorCode" } } }
    },
    "selectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "commandId",
        "bootId",
        "eventSequence",
        "status",
        "revision",
        "compartment",
        "physicalVerification",
        "requiresReload"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "selection.result" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "status": { "enum": ["completed", "aborted", "outcome_unknown"] },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "compartment": { "type": "integer", "minimum": 1, "maximum": 6 },
        "physicalVerification": { "const": "unavailable" },
        "requiresReload": { "type": "boolean" }
      }
    },
    "stateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "deviceId",
        "bootId",
        "deviceUptimeMs",
        "eventSequence",
        "revision",
        "controlMode",
        "controlLeaseId",
        "phase",
        "activeCommandId",
        "readyMask",
        "calibrationRevision",
        "faults",
        "microphoneState",
        "capabilities",
        "lastResult"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "state.snapshot" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "deviceUptimeMs": { "$ref": "#/$defs/safeInteger" },
        "eventSequence": { "$ref": "#/$defs/safeInteger" },
        "revision": { "$ref": "#/$defs/safeInteger" },
        "controlMode": { "enum": ["standalone", "manual", "recovery"] },
        "controlLeaseId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "phase": {
          "enum": [
            "bootSafe",
            "recoveryRequired",
            "ready",
            "searching",
            "highlighting",
            "vibrating",
            "releasing",
            "stopped",
            "fault"
          ]
        },
        "activeCommandId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
        },
        "readyMask": { "type": "integer", "minimum": 0, "maximum": 63 },
        "calibrationRevision": { "$ref": "#/$defs/safeInteger" },
        "faults": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/faultCode" }
        },
        "microphoneState": {
          "enum": ["unavailable", "idle", "recording", "playing"]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
        },
        "lastResult": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/selectionResult" }
          ]
        }
      },
      "if": { "properties": { "controlMode": { "const": "manual" } } },
      "then": { "properties": { "controlLeaseId": { "$ref": "#/$defs/uuid" } } },
      "else": { "properties": { "controlLeaseId": { "type": "null" } } }
    },
    "safetyStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "messageId", "deviceId", "bootId"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "safety.stop" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" }
      }
    },
    "safetyReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "messageId",
        "deviceId",
        "bootId",
        "controlLeaseId",
        "inspectionConfirmed"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "type": { "const": "safety.reset" },
        "messageId": { "$ref": "#/$defs/uuid" },
        "deviceId": { "$ref": "#/$defs/deviceId" },
        "bootId": { "$ref": "#/$defs/uuid" },
        "controlLeaseId": { "$ref": "#/$defs/uuid" },
        "inspectionConfirmed": { "const": true }
      }
    }
  }
}
