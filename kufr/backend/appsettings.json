{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "GptLive": {
      "ActorMode": "LegacyBackendScripted",
      "AdultLanguage": true,
      "TranscriptCharacterLimit": 128000,
      "DecisionContextBytes": 8000,
      "DelegationContextWaitMs": 350,
      "DelegationTimeoutMs": 8000,
      "OutputPauseMs": 900,
      "TerminalQuietMs": 4000,
      "TerminalTimeoutSeconds": 35,
      "SpeechAmplitudeThreshold": 256
    },
    "Memory": {
      "Enabled": false,
      "CloudIndexingEnabled": false,
      "LongTermPersonalEnabled": false,
      "AppNamespace": "kufr",
      "PersonalStoreId": "",
      "MotifStoreId": "",
      "ContextTokens": 500,
      "SearchResults": 5,
      "TimeoutSeconds": 15,
      "Concurrency": 2,
      "MaxAttempts": 6,
      "RetryBaseSeconds": 2,
      "IndexPollSeconds": 2,
      "IndexTimeoutSeconds": 120,
      "ConversationRetentionHours": 24,
      "MotifRetentionDays": 1,
      "PersonalRetentionDays": 30,
      "MaxWritesPerDay": 2000,
      "MaxSearchesPerDay": 100,
      "MaxUploadsPerDay": 500,
      "MaxStoredBytes": 2000000,
      "MaxRecordBytes": 2000,
      "MaxPendingJobs": 4000
    }
  }
}
