          "type": "boolean"
        }
      }
    },
    "offlineoutboxreply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "bootId",
        "requestMessageId",
        "accepted",
        "errorCode",
        "offline",
        "records"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "type": {
          "const": "offline.outbox"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "requestMessageId": {
          "$ref": "#/$defs/uuid"
        },
        "accepted": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "offline": {
          "$ref": "#/$defs/offlineStatus"
        },
        "records": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/offlineOutcome"
          }
        }
      }
    }
  }
}
